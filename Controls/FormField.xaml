<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="BudgetEtu.Controls.FormField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <!--
        Champ de formulaire : libellé + champ arrondi + message d'erreur.
        En erreur : contour et fond rouges, pictogramme « (!) » et message précédé de ⚠️,
        exactement comme la maquette « 4_SaisieTransaction_Erreur ».
    -->
    <VerticalStackLayout Spacing="6">

        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource FieldLabel}" />

        <Border Style="{StaticResource InputBorder}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasError, Source={x:Reference Root}}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorSoft}" />
                </DataTrigger>
            </Border.Triggers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    x:Name="Input"
                    Grid.Column="0"
                    VerticalOptions="Center"
                    Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                    Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                    Keyboard="{Binding Keyboard, Source={x:Reference Root}}" />

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Label Text="{Binding Suffix, Source={x:Reference Root}}"
                           IsVisible="{Binding HasSuffix, Source={x:Reference Root}}"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Text="(!)" TextColor="{StaticResource Error}" FontFamily="{StaticResource FontBold}"
                           IsVisible="{Binding HasError, Source={x:Reference Root}}" />
                    <Label x:Name="ToggleLabel" Text="Afficher" Style="{StaticResource LinkLabel}" FontSize="12"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Label Text="{Binding ErrorText, Source={x:Reference Root}}"
               Style="{StaticResource FieldError}"
               IsVisible="{Binding HasError, Source={x:Reference Root}}" />

    </VerticalStackLayout>
</ContentView>
