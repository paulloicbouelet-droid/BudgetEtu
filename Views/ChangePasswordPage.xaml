<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BudgetEtu.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BudgetEtu.Controls"
    xmlns:vm="clr-namespace:BudgetEtu.ViewModels"
    x:DataType="vm:ChangePasswordViewModel"
    Title="Changer le mot de passe"
    Shell.NavBarIsVisible="False">

    <!-- Écran ajouté : même style que la saisie de transaction (titre + croix de fermeture). -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="24,32,24,20" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="Changer le mot de passe" Style="{StaticResource ScreenTitle}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="✕" TextColor="{StaticResource Expense}" FontSize="22" Padding="12,6">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">

                <controls:ErrorBanner Message="{Binding BannerMessage}" />

                <controls:FormField
                    Title="Mot de passe actuel"
                    Placeholder="••••••••"
                    IsPassword="True"
                    Text="{Binding CurrentPassword}"
                    ErrorMessage="{Binding CurrentPasswordError}" />

                <controls:FormField
                    Title="Nouveau mot de passe"
                    Placeholder="••••••••"
                    IsPassword="True"
                    Text="{Binding NewPassword}"
                    ErrorMessage="{Binding NewPasswordError}" />

                <controls:FormField
                    Title="Confirmer le nouveau mot de passe"
                    Placeholder="••••••••"
                    IsPassword="True"
                    Text="{Binding ConfirmPassword}"
                    ErrorMessage="{Binding ConfirmPasswordError}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Button Text="Modifier le mot de passe"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
