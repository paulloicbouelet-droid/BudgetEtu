<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BudgetEtu.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BudgetEtu.Controls"
    xmlns:vm="clr-namespace:BudgetEtu.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="Mot de passe oublié"
    Shell.NavBarIsVisible="False">

    <!-- Maquette 8_MotDePasseOublie -->
    <Grid RowDefinitions="*,Auto" Padding="24,48,24,20">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Réinitialisation" Style="{StaticResource Title}" />
                    <Label Text="Renseigne ton e-mail pour recevoir un lien de récupération"
                           Style="{StaticResource Subtitle}" />
                </VerticalStackLayout>

                <!-- Erreur (compte introuvable, hors ligne…) puis confirmation d'envoi -->
                <controls:ErrorBanner Message="{Binding BannerMessage}" Margin="0,4,0,0" />
                <controls:ErrorBanner Message="{Binding SuccessMessage}" IsSuccess="True" />

                <controls:FormField
                    Title="Adresse E-mail"
                    Placeholder="etudiant@univ.cm"
                    Keyboard="Email"
                    Text="{Binding Email}"
                    ErrorMessage="{Binding EmailError}" />

                <Button Text="Envoyer le lien"
                        Command="{Binding SendLinkCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1" Text="Retour à la connexion" Style="{StaticResource LinkLabel}"
               HorizontalOptions="Center" Padding="0,8">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
            </Label.GestureRecognizers>
        </Label>

    </Grid>
</ContentPage>
